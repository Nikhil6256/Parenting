# ============================================================
# RISE WITH RUPALI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your credentials
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas Connection)
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.4phkxbm.mongodb.net/risewithrupali?appName=Cluster0

# ------------------------------------------------------------
# 2. NEXTAUTH (Authentication & Session Management)
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-min-32-chars

# ------------------------------------------------------------
# 3. RAZORPAY (Payment Gateway Integration)
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ------------------------------------------------------------
# 4. CLOUDINARY (Images, Thumbnails & Assets Storage)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------
# 5. BUNNY.NET (Video Hosting, Streaming & Storage API)
# ------------------------------------------------------------
# Stream Video Library ID from Bunny.net dashboard
BUNNY_LIBRARY_ID=your_bunny_library_id

# Account / Stream Library API Key for Video API management and uploads
BUNNY_API_KEY=your_bunny_api_key

# CDN Hostname for streaming embeds (e.g. vz-xxxx.b-cdn.net or iframe.mediadelivery.net)
BUNNY_CDN_HOSTNAME=your-hostname.b-cdn.net

# (Optional) Storage Zone details if using Bunny Storage for supplementary assets
BUNNY_STORAGE_ZONE_NAME=your_storage_zone_name
BUNNY_STORAGE_API_KEY=your_storage_api_key

# ------------------------------------------------------------
# 6. EMAIL / SMTP (Nodemailer Contact Form Notifications)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
OWNER_EMAIL=rupsdabade@gmail.com

# ------------------------------------------------------------
# 7. SEED SCRIPT (Initial Admin/Owner Account Setup)
# ------------------------------------------------------------
SEED_OWNER_NAME=Rupali
SEED_OWNER_EMAIL=rupsdabade@gmail.com
SEED_OWNER_PASSWORD=ChangeMe@123!
